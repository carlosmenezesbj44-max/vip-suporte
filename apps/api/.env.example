# Banco de dados
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/canal_direto?schema=public"

# JWT
JWT_SECRET="troque-por-um-segredo-forte"
JWT_EXPIRES_IN="7d"

# Chave de criptografia das credenciais de integrações salvas no painel.
# Mantenha estável e diferente em produção; gere com: openssl rand -hex 32
SETTINGS_ENCRYPTION_KEY="troque-por-uma-chave-aleatoria-de-32-bytes"

# Integração IXC Soft
IXC_API_URL="https://seu-provedor.ixcsoft.com.br/webservice/v1"
IXC_API_TOKEN="token-base64-do-ixc"

# Porta da API
PORT=3333
